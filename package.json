{
	"name": "dev-books-template",
	"description": "Astro and Starlight template for Thai programming books",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"author": "Premix Labs",
	"repository": {
		"type": "git",
		"url": "https://github.com/premix-labs/dev-books-template.git"
	},
	"homepage": "https://premix-labs.github.io/dev-books-template/",
	"engines": {
		"node": ">=22.19.0",
		"npm": ">=9.6.5"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"check": "astro check && tsc --noEmit",
		"test": "node --test tests/unit/*.test.mjs",
		"test:content": "node --test tests/content/*.test.mjs",
		"test:e2e": "playwright test",
		"test:links": "node scripts/check-links.mjs",
		"test:reuse": "node scripts/test-reuse.mjs",
		"test:dev": "node scripts/test-dev.mjs",
		"test:budget": "node scripts/check-budget.mjs",
		"measure:performance": "node scripts/measure-performance.mjs",
		"validate": "npm run test && npm run build && npm run test:links && npm run test:budget",
		"prebuild": "npm run check",
		"build": "astro build --force",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "^0.4.2",
		"@astrojs/starlight": "^0.42.4",
		"@astrojs/starlight-tailwind": "^5.0.0",
		"@fontsource-variable/noto-sans-thai": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.5",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.63.0",
		"typescript": "^6.0.3"
	},
	"allowScripts": {
		"esbuild": true
	}
}
