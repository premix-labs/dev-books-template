---
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from './ThemeSelect.astro';
import { getNavigation } from '../lib/navigation';
const navItems = getNavigation(Astro.url.pathname);
const { hasSidebar } = Astro.locals.starlightRoute;
---
<div class="grid h-full grid-cols-[minmax(10rem,1fr)_auto_minmax(10rem,1fr)] items-center gap-8 max-[49.99rem]:grid-cols-[minmax(0,1fr)_auto_auto] max-[49.99rem]:gap-2">
	<div class="min-w-0 [&_.site-title]:text-[1.55rem] [&_.site-title]:font-[760] [&_.site-title]:tracking-[-0.04em] [&_.site-title]:text-[var(--sl-color-white)] max-[26rem]:[&_.site-title]:text-[clamp(1rem,5.6vw,1.35rem)]"><SiteTitle /></div>
	<nav class="flex h-[calc(var(--sl-nav-height)-2*var(--sl-nav-pad-y))] items-stretch gap-10 max-[49.99rem]:hidden" aria-label="เมนูหลัก">
		{navItems.map(item => <a href={item.href} aria-current={item.active ? 'page' : undefined} class="relative inline-flex items-center text-[0.95rem] font-semibold text-[var(--sl-color-gray-2)] no-underline after:absolute after:inset-x-0 after:bottom-[-0.78rem] after:h-[3px] after:origin-center after:scale-x-0 after:bg-[var(--sl-color-accent)] after:content-[''] after:transition-transform after:duration-150 hover:text-[var(--sl-color-text-accent)] hover:after:scale-x-100 aria-[current=page]:text-[var(--sl-color-text-accent)] aria-[current=page]:after:scale-x-100 motion-reduce:after:transition-none">{item.label}</a>)}
	</nav>
	{!hasSidebar && <>
		<button type="button" popovertarget="mobile-primary-menu" data-menu-toggle aria-label="เมนูหลัก" class="hidden size-11 cursor-pointer items-center justify-center rounded-md border border-[var(--sl-color-gray-5)] text-[var(--sl-color-gray-2)] max-[49.99rem]:inline-flex">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
		</button>
		<nav popover="auto" id="mobile-primary-menu" aria-label="เมนูหลักบนมือถือ" class="fixed inset-x-0 top-[var(--sl-nav-height)] bottom-auto m-0 max-h-[calc(100dvh-var(--sl-nav-height))] w-full overflow-y-auto border-0 border-b border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg-nav)] px-4 py-3 text-[var(--sl-color-gray-2)] shadow-lg">
			{navItems.map(item => <a href={item.href} aria-current={item.active ? 'page' : undefined} class="block rounded-md p-3 font-semibold no-underline hover:bg-[var(--sl-color-gray-7)] aria-[current=page]:text-[var(--sl-color-text-accent)]">{item.label}</a>)}
			<div class="mt-2 border-t border-[var(--sl-color-gray-5)] pt-3"><ThemeSelect /></div>
		</nav>
	</>}
	<div class:list={['flex items-center justify-self-end gap-3 max-[49.99rem]:[&>.book-theme]:hidden', { 'max-[49.99rem]:col-span-2': hasSidebar }]}>
		<Search /><ThemeSelect />
	</div>
</div>
<script>
	import '../scripts/code-copy';
	const panel = document.querySelector<HTMLElement>('#mobile-primary-menu');
	panel?.addEventListener('click', event => { if ((event.target as Element).closest('a')) panel.hidePopover(); });
	panel?.addEventListener('focusout', event => {
		if (event.relatedTarget instanceof Node && !panel.contains(event.relatedTarget)) panel.hidePopover();
	});
	matchMedia('(min-width: 50rem)').addEventListener('change', ({ matches }) => { if (matches) panel?.hidePopover(); });
	document.querySelector('[data-open-modal]')?.addEventListener('click', () => panel?.hidePopover());
	document.querySelector('site-search dialog')?.addEventListener('beforetoggle', event => {
		if ((event as ToggleEvent).newState === 'open') document.querySelectorAll<HTMLElement>('[popover]:popover-open').forEach(menu => menu.hidePopover());
	});
</script>
