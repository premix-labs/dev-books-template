---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const pathname = Astro.url.pathname;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const navItems = [
	{ label: 'หน้าแรก', href: base, active: pathname === base },
	{ label: 'หนังสือ', href: `${base}#books`, active: false },
	{ label: 'เกี่ยวกับ', href: `${base}about/`, active: pathname.startsWith(`${base}about`) },
];
---

<div class="header-shell">
	<div class="title-wrapper">
		<SiteTitle />
	</div>

	<nav class="desktop-nav" aria-label="เมนูหลัก">
		{
			navItems.map((item) => (
				<a href={item.href} class:list={{ active: item.active }} aria-current={item.active ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
	</nav>

	<details class="mobile-nav">
		<summary aria-label="เปิดเมนูหลัก">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M4 7h16M4 12h16M4 17h16" />
			</svg>
		</summary>
		<nav class="mobile-nav-panel" aria-label="เมนูหลักบนมือถือ">
			{
				navItems.map((item) => (
					<a href={item.href} aria-current={item.active ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>
	</details>

	<div class="tools">
		{shouldRenderSearch && <Search />}
		<ThemeSelect />
	</div>
</div>

<style>
	.header-shell {
		display: grid;
		grid-template-columns: minmax(10rem, 1fr) auto minmax(10rem, 1fr);
		align-items: center;
		gap: 2rem;
		height: 100%;
	}

	.title-wrapper {
		min-width: 0;
	}

	.desktop-nav {
		display: flex;
		align-items: stretch;
		gap: 2.5rem;
		height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
	}

	.desktop-nav a {
		position: relative;
		display: inline-flex;
		align-items: center;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}

	.desktop-nav a::after {
		position: absolute;
		inset: auto 0 -0.78rem;
		height: 3px;
		background: var(--sl-color-accent);
		content: '';
		transform: scaleX(0);
		transform-origin: center;
		transition: transform 160ms ease;
	}

	.desktop-nav a:hover,
	.desktop-nav a:focus-visible,
	.desktop-nav a.active {
		color: var(--sl-color-text-accent);
	}

	.desktop-nav a:hover::after,
	.desktop-nav a:focus-visible::after,
	.desktop-nav a.active::after {
		transform: scaleX(1);
	}

	.tools {
		display: flex;
		justify-self: end;
		align-items: center;
		gap: 0.75rem;
	}

	.mobile-nav {
		display: none;
	}

	@media (max-width: 49.99rem) {
		.header-shell {
			grid-template-columns: minmax(0, 1fr) auto auto;
			gap: 0.75rem;
		}

		.desktop-nav,
		.tools > :global(starlight-theme-select) {
			display: none;
		}

		.mobile-nav {
			display: block;
			order: 2;
		}

		.mobile-nav summary {
			display: grid;
			width: 2rem;
			height: 2rem;
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 0.35rem;
			place-items: center;
			color: var(--sl-color-gray-2);
			cursor: pointer;
			list-style: none;
		}

		.mobile-nav summary::-webkit-details-marker {
			display: none;
		}

		.mobile-nav summary:hover,
		.mobile-nav summary:focus-visible {
			border-color: var(--sl-color-accent);
			color: var(--sl-color-text-accent);
		}

		.mobile-nav summary svg {
			width: 1.15rem;
			height: 1.15rem;
			fill: none;
			stroke: currentColor;
			stroke-linecap: round;
			stroke-width: 1.8;
		}

		.mobile-nav-panel {
			position: fixed;
			inset: var(--sl-nav-height) 0 auto;
			display: flex;
			flex-direction: column;
			border-bottom: 1px solid var(--sl-color-gray-5);
			padding: 0.75rem 1rem 1rem;
			background: var(--sl-color-bg-nav);
			box-shadow: 0 0.75rem 2rem rgb(18 32 62 / 10%);
		}

		.mobile-nav-panel a {
			border-radius: 0.35rem;
			padding: 0.75rem;
			color: var(--sl-color-gray-2);
			font-size: 0.95rem;
			font-weight: 600;
			text-decoration: none;
		}

		.mobile-nav-panel a:hover,
		.mobile-nav-panel a:focus-visible,
		.mobile-nav-panel a[aria-current='page'] {
			background: var(--sl-color-gray-7);
			color: var(--sl-color-text-accent);
		}

		.tools {
			order: 3;
		}
	}
</style>
