---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;

const books = [
	{ number: '01', title: 'C# สำหรับ Developer', href: `${base}csharp/` },
	{ number: '02', title: 'TypeScript สำหรับ Developer', href: `${base}typescript/` },
	{ number: '03', title: 'Python สำหรับ Developer', href: `${base}python/` },
];
---

<div class="book-index not-content">
	<section id="books" aria-labelledby="books-title">
		<h2 id="books-title">หนังสือในชุด</h2>
		<ol>
			{
				books.map((book) => (
					<li>
						<a href={book.href}>
							<span class="book-number">{book.number}</span>
							<strong>{book.title}</strong>
							<span class="book-status">กำลังวางแผนเนื้อหา</span>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="m9 5 7 7-7 7" />
							</svg>
						</a>
					</li>
				))
			}
		</ol>
	</section>

	<footer>Dev Books</footer>
</div>

<style>
	.book-index {
		padding-bottom: 0.5rem;
	}

	.book-index h2 {
		margin: 0;
		padding-bottom: 1.15rem;
		font-size: clamp(1.65rem, 2.6vw, 2.25rem);
		font-weight: 720;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
	}

	.book-index ol {
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--sl-color-gray-5);
		list-style: none;
	}

	.book-index li {
		margin: 0;
		border-bottom: 1px solid var(--sl-color-gray-5);
	}

	.book-index li a {
		display: grid;
		grid-template-columns: 5rem minmax(0, 1fr) auto 1.5rem;
		align-items: center;
		gap: 1.25rem;
		padding: 1.5rem 1.25rem;
		color: var(--sl-color-white);
		text-decoration: none;
		transition: background-color 150ms ease, padding-inline 150ms ease;
	}

	.book-index li a:hover,
	.book-index li a:focus-visible {
		padding-inline: 1.5rem 1rem;
		background: var(--sl-color-gray-7);
		outline: none;
	}

	.book-number {
		font-family: var(--__sl-font-mono);
		font-size: 1.25rem;
		font-weight: 750;
		color: var(--sl-color-accent);
	}

	.book-index strong {
		font-size: clamp(1.05rem, 1.6vw, 1.3rem);
		font-weight: 650;
	}

	.book-status {
		font-size: 0.95rem;
		color: var(--sl-color-gray-3);
	}

	.book-index svg {
		width: 1.4rem;
		height: 1.4rem;
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
		transition: transform 150ms ease;
	}

	.book-index a:hover svg,
	.book-index a:focus-visible svg {
		transform: translateX(0.25rem);
	}

	.book-index footer {
		margin-top: 3rem;
		border-top: 1px solid var(--sl-color-gray-5);
		padding: 2rem 0 0;
		font-size: 1rem;
		font-weight: 700;
		color: var(--sl-color-white);
	}

	@media (max-width: 42rem) {
		.book-index li a {
			grid-template-columns: 3.25rem minmax(0, 1fr) 1.25rem;
			gap: 0.75rem;
			padding-inline: 0;
		}

		.book-index li a:hover,
		.book-index li a:focus-visible {
			padding-inline: 0.5rem 0;
		}

		.book-status {
			grid-column: 2;
			font-size: 0.82rem;
		}

		.book-index svg {
			grid-column: 3;
			grid-row: 1 / span 2;
		}
	}
</style>
