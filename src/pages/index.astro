---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import BookIndex from '../components/BookIndex.astro';
import { book } from '../../book.config.mjs';
---
<StarlightPage frontmatter={{ title: book.headline.join(' '), description: book.description, template: 'splash', hero: { tagline: book.description }, tableOfContents: false, pagefind: false, pagination: false, editUrl: false }}>
	<BookIndex />
</StarlightPage>
